{
  "name": "@harmony/client",
  "version": "3.8.2",
  "private": true,
  "description": "Harmony desktop client: share a screen or window, or watch someone else's",
  "author": "Pedro Lucas Miguel",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroLucasMiguel/harmony.git"
  },
  "main": "src/main/index.js",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node test/smoke.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:channel-video": "node test/channel-video.mjs",
    "test:ui": "node test/channels-ui.mjs",
    "test:chat-scroll": "node test/chat-scroll.mjs",
    "test:camera-background": "node test/camera-background.mjs",
    "test:camera-quality": "node test/camera-quality.mjs",
    "test:mic-processing": "node test/mic-processing.mjs",
    "test:profile-style": "node test/profile-style.mjs",
    "test:stream-layout": "node test/stream-layout.mjs",
    "test:channel-groups": "node test/channel-groups.mjs",
    "test:profile-tab": "node test/profile-tab.mjs",
    "test:attachments": "node test/attachments.mjs",
    "test:i18n": "node test/i18n.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "test:soundpad-hotkeys": "node test/soundpad-hotkeys.mjs",
    "test:voice": "node test/voice-ui.mjs",
    "test:audio": "node --test test/audio-backends.test.mjs",
    "test:realtime": "node --test --test-timeout=180000 --test-concurrency=1 test/realtime-client.test.mjs",
    "build": "node scripts/build.js fast",
    "build:release": "node scripts/build.js release",
    "build:zip": "node scripts/build.js fast --win zip",
    "build:all": "node scripts/build.js release --win nsis --linux AppImage --mac dmg zip",
    "build:web": "node scripts/build-web.js",
    "web": "node scripts/serve-web.js",
    "android:sync": "node scripts/build-web.js && cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@phosphor-icons/core": "^2.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "optionalDependencies": {
    "loopback-capture": "^3.0.2"
  },
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "electron-updater": "^6.8.9",
    "mp4-muxer": "^5.2.2"
  }
}
