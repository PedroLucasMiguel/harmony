    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@phosphor-icons/core": "^2.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2"
  },
  "optionalDependencies": {
    "loopback-capture": "^3.0.2",
    "uiohook-napi": "^1.5.5"
  },
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "electron-updater": "^6.8.9",
    "mp4-muxer": "^5.2.2"
  }
}
