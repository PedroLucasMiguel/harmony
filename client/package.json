    "test:mic-worker": "node test/mic-worker.mjs",
    "test:media-attachments": "node test/media-attachments.mjs",
    "test:byte-range": "node --test test/byte-range.test.mjs",
    "test:voice-notes": "node test/voice-notes.mjs",
    "test:link-embeds": "node test/link-embeds.mjs",
    "test:youtube-player": "node test/youtube-player.mjs",
