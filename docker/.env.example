# Copy to .env next to docker-compose.yml.

# The public hostname or IP clients will reach. MediaMTX advertises this as an
# ICE candidate, and without it nobody outside this machine can connect --
# remote clients only ever see the container's private address.
#
# For a LAN-only test this can be the host's LAN address, e.g. 192.168.1.50.
HARMONY_PUBLIC_HOST=stream.example.com

# Where CLIENTS reach the WHIP/WHEP signaling endpoint: whatever sits in front
# of the container's port 8889, including the public port.
#
#   LAN test:            http://192.168.1.50:8889
#   Behind Caddy/tunnel: https://stream.example.com:8444
HARMONY_SIGNALING_URL=https://stream.example.com:8444

# A single shared password for the whole server. Leave it empty and anyone who
# can reach the server can use it. Three wrong answers from one address costs
# 5 minutes, then 10, then 30, then 60.
HARMONY_PASSWORD=
