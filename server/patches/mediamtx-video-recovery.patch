diff --git a/internal/protocols/webrtc/keyframe_requests.go b/internal/protocols/webrtc/keyframe_requests.go
new file mode 100644
index 0000000..a089e25
--- /dev/null
+++ b/internal/protocols/webrtc/keyframe_requests.go
@@ -0,0 +1,85 @@
+package webrtc
+
+import (
+	"sync"
+	"time"
+
+	"github.com/pion/rtcp"
+	"github.com/pion/webrtc/v4"
+)
+
+// A viewer that has lost part of a picture and cannot get it back (a retransmission that was itself lost, or one
+// that came too late) asks for a whole new one: a picture loss indication, or a full intra request. The relay's answer
+// never offered it ("nack pli"), so a browser never asked, and had it asked, the request was read and dropped. The
+// viewer stayed frozen until the next key frame the publisher happened to make, which was whenever the relay's own
+// periodic request came round, and a person who joined waited for that too. Now the answer offers it, and the request
+// is passed on to whoever publishes the path.
+//
+// Many viewers can ask at once, and a key frame is many times the size of any other frame, so the publisher is asked
+// at most once every keyFrameRequestGap however many ask; a viewer's request inside that gap is covered by the
+// key frame that the previous one made.
+
+const keyFrameRequestGap = 500 * time.Millisecond
+
+type keyFrameSource struct {
+	request func()
+	last    time.Time
+}
+
+var (
+	keyFrameMutex   sync.Mutex
+	keyFrameSources = map[string]*keyFrameSource{}
+)
+
+// RegisterKeyFrameSource says that request makes the publisher of the path send a key frame. The returned function
+// takes it away again; call it when the publisher is gone.
+func RegisterKeyFrameSource(pathName string, request func()) func() {
+	source := &keyFrameSource{request: request}
+
+	keyFrameMutex.Lock()
+	keyFrameSources[pathName] = source
+	keyFrameMutex.Unlock()
+
+	return func() {
+		keyFrameMutex.Lock()
+		defer keyFrameMutex.Unlock()
+		if keyFrameSources[pathName] == source {
+			delete(keyFrameSources, pathName)
+		}
+	}
+}
+
+// RequestKeyFrame asks the publisher of the path for a key frame, unless one was asked for a moment ago.
+func RequestKeyFrame(pathName string) {
+	keyFrameMutex.Lock()
+	source := keyFrameSources[pathName]
+	if source == nil || time.Since(source.last) < keyFrameRequestGap {
+		keyFrameMutex.Unlock()
+		return
+	}
+	source.last = time.Now()
+	keyFrameMutex.Unlock()
+
+	source.request()
+}
+
+// RequestKeyFrame asks the peer publishing to this connection for a key frame on each of its video tracks.
+func (co *PeerConnection) RequestKeyFrame() {
+	for _, track := range co.inboundTracks {
+		if track.track.Kind() != webrtc.RTPCodecTypeVideo || track.writeRTCP == nil {
+			continue
+		}
+		track.writeRTCP([]rtcp.Packet{ //nolint:errcheck
+			&rtcp.PictureLossIndication{MediaSSRC: uint32(track.track.SSRC())},
+		})
+	}
+}
+
+// OnKeyFrameRequest is called when the peer reading from this connection asks for a key frame on a video track.
+func (co *PeerConnection) OnKeyFrameRequest(f func()) {
+	for _, track := range co.OutboundTracks {
+		if track.isVideo() {
+			track.onKeyFrameRequest = f
+		}
+	}
+}
