# Copy to .env (or /etc/harmony/harmony.env for a systemd install).
# Every value here is optional; the defaults work for a LAN-only test.

# ---------------------------------------------------------------------------
# Harmony control server
# ---------------------------------------------------------------------------
HARMONY_PORT=8080
HARMONY_HOST=0.0.0.0

# Where CLIENTS reach MediaMTX's WHIP/WHEP signaling endpoint. This is plain
# HTTP, so it is the one part of Harmony that can go through a reverse proxy or
# a Cloudflare Tunnel. Media does NOT flow through it.
#
#   LAN test:            http://192.168.1.50:8889
#   Behind Caddy/tunnel: https://stream.example.com
HARMONY_SIGNALING_URL=http://192.168.1.50:8889

# How long a username stays reserved before the user starts publishing.
HARMONY_CLAIM_TTL_MS=30000

# A single shared password for the whole server. Leave it unset (or empty) and
# the server is open to anyone who can reach it, which is the original
# behaviour. Set it and nothing but /api/health answers without it -- including
# the media, because watch URLs then carry a token of their own.
#
# Wrong answers are rate limited per client address on an escalating ladder:
# three wrong passwords costs 5 minutes, the next three 10, then 30, then 60,
# and it stays at 60. A correct password clears the count. Offering no password
# at all does not count as an attempt.
#HARMONY_PASSWORD=change-me
#HARMONY_MAX_LOGIN_ATTEMPTS=3
#HARMONY_LOCKOUT_MINUTES=5,10,30,60

# Comma-separated STUN servers handed to clients so they can discover their own
# public address.
HARMONY_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Optional TURN relay -- the last resort for a client whose network blocks both
# the UDP and the TCP media ports. Try ICE-TCP first (MTX_WEBRTCLOCALTCPADDRESS
# below): it costs nothing and needs no third party.
#
# The server itself never needs TURN; it has a reachable public address. This is
# only ever about the client's side of the connection.
#
# Free tiers that work here (all standard TURN, no SDK required):
#   Open Relay / Metered  20 GB/month with a card on file, 0.5 GB without
#   ExpressTurn           100 GB/month
#   Cloudflare Realtime   free only alongside their SFU, otherwise $0.05/GB
#
# Relayed traffic is charged per gigabyte and screen sharing is measured in
# megabits per second, so treat any free tier as a handful of hours, not a
# default path. Only the clients that cannot connect otherwise will use it.
#HARMONY_TURN_URL=turn:standard.relay.metered.ca:80?transport=tcp
#HARMONY_TURN_USERNAME=your-username
#HARMONY_TURN_PASSWORD=your-credential

# ---------------------------------------------------------------------------
# MediaMTX overrides (MTX_ prefix -- read by MediaMTX, not by Harmony)
# ---------------------------------------------------------------------------

# REQUIRED for anyone connecting from outside your LAN. The public hostname or
# static IP of this host, which MediaMTX advertises as an ICE candidate. Without
# it, remote clients only ever see its private address and fail to connect.
MTX_WEBRTCADDITIONALHOSTS=stream.example.com

# The UDP media port. Whatever you set here must be forwarded on your router,
# as UDP, to this host. Cloudflare Tunnel cannot carry this traffic.
MTX_WEBRTCLOCALUDPADDRESS=:8189

# The same port over TCP, for clients whose network blocks UDP entirely.
# Forward this as TCP too. Without it, such clients have no path at all and
# the only remaining option is a paid TURN relay.
MTX_WEBRTCLOCALTCPADDRESS=:8189
