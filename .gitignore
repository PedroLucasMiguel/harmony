# ---------------------------------------------------------------------------
# Secrets and per-host configuration -- never commit these
# ---------------------------------------------------------------------------

# Real configuration. server/.env.example is the committed template.
.env
.env.*
*.env
!.env.example
!*.env.example

# TLS material. MediaMTX writes auto.crt / auto.key beside itself the first
# time it needs a self-signed certificate, so running it from a checkout drops
# a private key straight into the repo root.
*.key
*.pem
*.crt
*.p12
*.pfx
cloudflare.ini

# macOS code signing: what client/scripts/make-mac-signing-cert.sh writes (the
# .p12 is the release identity itself, and the .base64 is the same thing as a
# line of text), and the throwaway keychain mac-signing-keychain.sh builds.
harmony-mac-signing/
*.p12.base64
*.keychain
*.keychain-db
*.cer
*.mobileprovision

# Notes about one specific installation -- hostnames, LAN addresses, which
# ports are open. DEPLOYMENT.md is the generic guide and IS committed.
*.local.md

# Personal tool state.
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Build output and dependencies
# ---------------------------------------------------------------------------
node_modules/
dist/
# The macOS audio helper, compiled by client/scripts/build-native.js.
client/build/native/
# The web/Android client, generated by `npm run build:web`.
client/www/
out/
*.tsbuildinfo

# MediaMTX is fetched by server/install.sh at the pinned version.
mediamtx
mediamtx.exe
recordings/


# ---------------------------------------------------------------------------
# Editors, OS and logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
.vscode/
.idea/
.DS_Store
Thumbs.db

media/harmony-demo.mp4
